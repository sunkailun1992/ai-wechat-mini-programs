.chat-page {
  position: relative;
  min-height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  background: #f7f9fc;
}

.custom-nav {
  flex: 0 0 auto;
  position: fixed;
  top: 0;
  right: 0;
  left: 0;
  z-index: 70;
  box-sizing: border-box;
  background: #ffffff;
  border-bottom: 1rpx solid #edf1f6;
}

.custom-nav-spacer {
  flex: 0 0 auto;
}

.custom-nav-content {
  position: relative;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 190rpx 0 104rpx;
}

.nav-menu-button {
  position: absolute;
  left: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 58rpx;
  height: 58rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #263245;
  background: #f3f6fa;
}

.nav-menu-icon {
  font-size: 34rpx;
  line-height: 1;
  font-weight: 500;
}

.custom-nav-title {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  max-width: 320rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #111827;
  font-size: 31rpx;
  font-weight: 600;
  text-align: center;
}

.drawer-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 80;
  background: rgba(15, 23, 42, 0.28);
}

.conversation-drawer {
  position: fixed;
  top: 0;
  bottom: 0;
  left: 0;
  z-index: 90;
  width: 552rpx;
  max-width: 74vw;
  box-sizing: border-box;
  padding: calc(72rpx + env(safe-area-inset-top)) 24rpx calc(24rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  background: #ffffff;
  box-shadow: 18rpx 0 42rpx rgba(15, 23, 42, 0.14);
}

.drawer-header {
  flex: 0 0 auto;
  min-height: 70rpx;
  margin-bottom: 28rpx;
  padding: 0 4rpx;
}

.drawer-title {
  display: block;
  color: #172033;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.25;
}

.drawer-subtitle {
  display: block;
  margin-top: 8rpx;
  color: #7a889b;
  font-size: 23rpx;
  line-height: 1.3;
}

.drawer-new::after {
  border: 0;
}

.drawer-content {
  flex: 1;
  min-height: 0;
}

.drawer-section {
  box-sizing: border-box;
  margin-bottom: 34rpx;
}

.drawer-section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 48rpx;
  margin-bottom: 12rpx;
}

.drawer-section-title {
  color: #172033;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.3;
}

.drawer-new {
  flex: 0 0 54rpx;
  width: 54rpx;
  height: 54rpx;
  line-height: 50rpx;
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  background: #1f6fff;
  font-size: 34rpx;
  font-weight: 600;
}

.drawer-item,
.drawer-questionnaire-item {
  box-sizing: border-box;
  min-height: 92rpx;
  margin-bottom: 10rpx;
  padding: 14rpx 16rpx;
  border-radius: 14rpx;
  color: #243145;
  background: #ffffff;
}

.drawer-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.drawer-item.active {
  background: #edf5ff;
}

.drawer-questionnaire-item {
  border: 1rpx solid #e2eaf5;
  background: #f8fafc;
}

.drawer-questionnaire-item:active {
  background: #edf5ff;
}

.drawer-item-main {
  flex: 1 1 auto;
  min-width: 0;
}

.drawer-item-title {
  display: block;
  max-width: 460rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 1.35;
}

.drawer-item .drawer-item-title {
  max-width: 360rpx;
}

.drawer-item-time {
  display: block;
  margin-top: 6rpx;
  color: #7a889b;
  font-size: 22rpx;
  line-height: 1.3;
}

.drawer-operation {
  flex: 0 0 52rpx;
  width: 52rpx;
  height: 52rpx;
  line-height: 42rpx;
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  border-radius: 14rpx;
  color: #6b7688;
  background: transparent;
  font-size: 34rpx;
  font-weight: 600;
}

.drawer-operation::after {
  border: 0;
}

.drawer-empty {
  padding: 36rpx 8rpx;
  color: #8190a4;
  font-size: 25rpx;
  text-align: center;
}

.message-list {
  flex: 1;
  height: 0;
  min-height: 0;
  box-sizing: border-box;
  padding: 30rpx 24rpx 22rpx;
}

.message {
  display: flex;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.message.user {
  justify-content: flex-end;
}

.message.assistant {
  justify-content: flex-start;
}

.assistant-avatar {
  flex: 0 0 48rpx;
  width: 48rpx;
  height: 48rpx;
  margin: 6rpx 14rpx 0 0;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  background: #1f6fff;
  font-size: 20rpx;
  font-weight: 600;
}

.bubble {
  max-width: 76%;
  box-sizing: border-box;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  line-height: 1.62;
  word-break: break-word;
  white-space: pre-wrap;
}

.message.assistant .bubble {
  background: #ffffff;
  color: #172033;
  border: 1rpx solid #e5ebf3;
  box-shadow: 0 6rpx 18rpx rgba(31, 58, 95, 0.04);
}

.message.user .bubble {
  background: #1f6fff;
  color: #ffffff;
  border-top-right-radius: 8rpx;
  box-shadow: 0 8rpx 20rpx rgba(31, 111, 255, 0.18);
}

.message-attachments {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.message-attachment {
  max-width: 430rpx;
}

.attachment-image {
  width: 330rpx;
  height: 224rpx;
  border-radius: 14rpx;
  background: #e7edf6;
}

.attachment-file {
  min-width: 300rpx;
  box-sizing: border-box;
  padding: 16rpx 18rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.88);
  color: #172033;
}

.message.assistant .attachment-file {
  background: #f4f7fb;
}

.attachment-name {
  display: block;
  max-width: 410rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 25rpx;
  line-height: 1.35;
}

.attachment-meta {
  display: block;
  margin-top: 4rpx;
  color: #738198;
  font-size: 21rpx;
  line-height: 1.3;
}

.typing {
  display: inline-flex;
  margin-left: 62rpx;
  padding: 12rpx 18rpx;
  border-radius: 18rpx;
  color: #66758a;
  background: #eef3f9;
  font-size: 24rpx;
}

.composer {
  flex: 0 0 auto;
  box-sizing: border-box;
  padding: 12rpx 18rpx 18rpx;
  background: #ffffff;
  border-top: 1rpx solid #e8edf5;
  box-shadow: 0 -10rpx 28rpx rgba(30, 54, 86, 0.05);
}

.questionnaire-mode-bar {
  height: 54rpx;
  box-sizing: border-box;
  margin-bottom: 12rpx;
  padding: 0 16rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #1f4e9a;
  background: #edf5ff;
  border: 1rpx solid #cfe2ff;
}

.questionnaire-mode-text {
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.3;
}

.questionnaire-exit {
  height: 42rpx;
  line-height: 42rpx;
  box-sizing: border-box;
  margin: 0;
  padding: 0 18rpx;
  border-radius: 14rpx;
  color: #536276;
  background: #ffffff;
  font-size: 22rpx;
  font-weight: 600;
}

.questionnaire-exit::after {
  border: 0;
}

.pending-attachments {
  width: 100%;
  white-space: nowrap;
}

.pending-attachments-inner {
  display: inline-flex;
  gap: 12rpx;
  padding: 2rpx 2rpx 14rpx;
}

.pending-attachment {
  position: relative;
  width: 168rpx;
  min-width: 168rpx;
  box-sizing: border-box;
  padding: 10rpx;
  border: 1rpx solid #dce6f2;
  border-radius: 16rpx;
  background: #f7f9fc;
}

.pending-thumb,
.pending-file-icon {
  width: 148rpx;
  height: 100rpx;
  border-radius: 12rpx;
  background: #e7edf6;
}

.pending-file-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #516071;
  font-size: 30rpx;
  font-weight: 600;
}

.pending-name {
  display: block;
  margin-top: 8rpx;
  color: #2d3a4e;
  font-size: 22rpx;
  line-height: 1.25;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pending-remove {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 38rpx;
  padding: 0;
  border-radius: 50%;
  background: #1f2937;
  color: #ffffff;
  font-size: 26rpx;
}

.input-bar {
  display: flex;
  align-items: flex-end;
  gap: 12rpx;
  box-sizing: border-box;
  min-height: 78rpx;
}

.attach-button {
  flex: 0 0 74rpx;
  width: 74rpx;
  min-width: 74rpx;
  max-width: 74rpx;
  height: 74rpx;
  line-height: 68rpx;
  box-sizing: border-box;
  padding: 0;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #1f6fff;
  background: #edf5ff;
  font-size: 42rpx;
  font-weight: 300;
  border: 1rpx solid #cfe2ff;
}

.attach-button[disabled] {
  color: #9aabbf;
  background: #edf1f6;
  border-color: #e2e8f0;
}

.input-shell {
  flex: 1 1 auto;
  min-width: 0;
  min-height: 74rpx;
  max-height: 178rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  background: #f3f6fa;
  border: 1rpx solid #e3eaf4;
  border-radius: 20rpx;
}

.message-input {
  width: 100%;
  min-height: 42rpx;
  max-height: 140rpx;
  color: #172033;
  font-size: 28rpx;
  line-height: 1.45;
}

.send-button {
  flex: 0 0 116rpx;
  width: 116rpx;
  min-width: 116rpx;
  max-width: 116rpx;
  height: 74rpx;
  line-height: 74rpx;
  box-sizing: border-box;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  background: #1f6fff;
  font-size: 27rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 18rpx rgba(31, 111, 255, 0.22);
}

.send-button[disabled] {
  color: #ffffff;
  background: #b9c5d6;
  box-shadow: none;
}
