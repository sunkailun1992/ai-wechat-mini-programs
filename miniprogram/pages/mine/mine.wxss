.mine-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 34rpx 28rpx;
  background: #f5f7fa;
}

.profile-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  box-sizing: border-box;
  padding: 34rpx;
  background: #ffffff;
  border-radius: 16rpx;
  border: 1rpx solid #e8edf5;
}

.avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: #e8eef7;
}

.profile-main {
  flex: 1;
  min-width: 0;
}

.nickname {
  color: #172033;
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.3;
}

.summary {
  margin-top: 10rpx;
  color: #6b7688;
  font-size: 26rpx;
}

.login-panel,
.info-list,
.action-area,
.questionnaire-panel {
  margin-top: 26rpx;
}

.login-panel,
.info-list,
.questionnaire-panel {
  box-sizing: border-box;
  padding: 28rpx;
  background: #ffffff;
  border-radius: 16rpx;
  border: 1rpx solid #e8edf5;
}

.info-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 84rpx;
  border-bottom: 1rpx solid #eef2f7;
}

.info-item:last-child {
  border-bottom: 0;
}

.label {
  color: #6b7688;
  font-size: 28rpx;
}

.value {
  max-width: 420rpx;
  color: #172033;
  font-size: 28rpx;
  text-align: right;
  word-break: break-all;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.section-title {
  color: #172033;
  font-size: 31rpx;
  font-weight: 600;
}

.section-refresh {
  height: 52rpx;
  line-height: 52rpx;
  padding: 0 20rpx;
  border-radius: 14rpx;
  color: #1777ff;
  background: #edf5ff;
  font-size: 24rpx;
  font-weight: 500;
}

.questionnaire-loading,
.empty-records {
  padding: 34rpx 0;
  color: #8190a4;
  font-size: 26rpx;
  text-align: center;
}

.questionnaire-record {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-height: 102rpx;
  box-sizing: border-box;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #eef2f7;
}

.questionnaire-record:last-child {
  border-bottom: 0;
}

.record-main {
  flex: 1;
  min-width: 0;
}

.record-title {
  color: #172033;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-meta {
  margin-top: 8rpx;
  color: #7a889b;
  font-size: 23rpx;
  line-height: 1.3;
}

.record-arrow {
  color: #a4afbd;
  font-size: 42rpx;
  line-height: 1;
}

.primary-button,
.secondary-button,
.logout-button {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 18rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.primary-button {
  color: #ffffff;
  background: #1777ff;
}

.secondary-button {
  color: #1777ff;
  background: #ffffff;
  border: 1rpx solid #d6e5ff;
}

.logout-button {
  margin-top: 20rpx;
  color: #e5484d;
  background: #ffffff;
  border: 1rpx solid #f2c8cb;
}
