.detail-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 28rpx;
  background: #f5f7fa;
}

.loading,
.empty-answers {
  padding: 48rpx 0;
  color: #8190a4;
  font-size: 26rpx;
  text-align: center;
}

.summary-card,
.answers-section {
  box-sizing: border-box;
  padding: 28rpx;
  border-radius: 16rpx;
  background: #ffffff;
  border: 1rpx solid #e8edf5;
}

.detail-title {
  color: #172033;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.3;
}

.detail-meta {
  margin-top: 12rpx;
  color: #536276;
  font-size: 25rpx;
  line-height: 1.35;
}

.code-line {
  margin-top: 12rpx;
  color: #8190a4;
  font-size: 22rpx;
  line-height: 1.35;
  word-break: break-all;
}

.answers-section {
  margin-top: 24rpx;
}

.section-title {
  margin-bottom: 18rpx;
  color: #172033;
  font-size: 30rpx;
  font-weight: 700;
}

.answer-card {
  box-sizing: border-box;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #eef2f7;
}

.answer-card:last-child {
  border-bottom: 0;
}

.question-label {
  color: #172033;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.45;
}

.question-prompt {
  margin-top: 10rpx;
  color: #536276;
  font-size: 25rpx;
  line-height: 1.55;
}

.answer-block {
  margin-top: 18rpx;
}

.answer-label {
  display: block;
  color: #8190a4;
  font-size: 22rpx;
  line-height: 1.3;
}

.answer-value {
  display: block;
  margin-top: 6rpx;
  color: #172033;
  font-size: 26rpx;
  line-height: 1.55;
  word-break: break-word;
}

.answer-time {
  margin-top: 14rpx;
  color: #a4afbd;
  font-size: 21rpx;
  line-height: 1.3;
}
