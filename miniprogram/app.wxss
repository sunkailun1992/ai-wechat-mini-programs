page {
  min-height: 100vh;
  background: #f5f7fa;
  color: #172033;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
}

button {
  padding: 0;
  margin: 0;
  background: transparent;
  border-radius: 0;
  line-height: inherit;
}

button::after {
  border: none;
}

.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}
